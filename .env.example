PRESTD_BASE_URL=http://localhost:3000
PRESTD_DATABASE=prest
PRESTD_SCHEMA=public

PRESTD_USERNAME=prest
PRESTD_PASSWORD=prest
# Alternative au username/password : un token déjà généré
# PRESTD_STATIC_TOKEN=eyJhbGciOi...

PRESTD_TIMEOUT_SECONDS=30

# Laisser vide pour désactiver l'auth propre au microservice
SERVICE_API_KEY=

CORS_ALLOW_ORIGINS=["*"]
LOG_LEVEL=INFO
